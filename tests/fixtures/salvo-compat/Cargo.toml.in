[package]
name = "saysion-salvo-compat"
version = "0.0.0"
edition = "2024"
rust-version = "1.95"
publish = false

[workspace]

[dependencies]
saysion = { path = "@SAYSION_PATH@", version = "=0.3.0" }
salvo_core = { version = "=1.0.1", default-features = false, features = ["cookie", "test"] }
cookie = { version = "0.18", features = ["percent-encode", "signed"] }
tracing = "0.1"
tokio = { version = "1.53.3", features = ["macros", "rt-multi-thread"] }
